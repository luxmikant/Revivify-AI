# ── Google Gemini ──
GOOGLE_API_KEY=

# ── Clerk (Backend) ──
CLERK_SECRET_KEY=sk_live_...

# ── Clerk (Frontend — Next.js) ──
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...

# ── Clerk (Frontend — Vite) ──
VITE_CLERK_PUBLISHABLE_KEY=pk_live_...

# ── Supabase (Direct Postgres Connection) ──
DATABASE_URL=postgresql://postgres.YOURREF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# ── Supabase (legacy, optional) ──
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── API URL (consumed by frontends) ──
NEXT_PUBLIC_API_URL=http://localhost:3001
VITE_API_URL=http://localhost:3001
